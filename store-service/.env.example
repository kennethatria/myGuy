DB_CONNECTION=host=postgres user=postgres password=your_password dbname=myguy port=5432 sslmode=disable
JWT_SECRET=your-secret-key
PORT=8081

# Chat API URL for sending booking notifications
CHAT_API_URL=http://localhost:8082/api/v1

# Internal API key for service-to-service communication (must match chat-service)
INTERNAL_API_KEY=your-internal-api-key-change-in-production
# Proximity service (rough locations); unset = locations are not saved
PROXIMITY_URL=http://localhost:8083
# "false" turns distance sorting and tags off
PROXIMITY_SORT_ENABLED=true
