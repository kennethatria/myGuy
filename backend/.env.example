PORT=8080
DB_CONNECTION=host=localhost user=postgres password=password dbname=my_guy port=5432 sslmode=disable
JWT_SECRET=your-secret-key

# Login-code email over SMTP (STARTTLS required). Leave SMTP_HOST empty in
# local development to log codes to the console instead of emailing them.
# Akamai/Linode blocks outbound 25/465/587 by default: use your provider's
# alternate port (e.g. Resend 2587, Brevo 2525).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="MyGuy <no-reply@myguy.work>"

# Proximity service (rough locations); unset = locations are not saved
PROXIMITY_URL=http://localhost:8083
# "false" turns distance sorting and tags off
PROXIMITY_SORT_ENABLED=true
