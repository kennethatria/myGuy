{#
  domain serves the app; redirect_domains (group_vars/app.yml) send their
  visitors to it.  tls_domains (deploy.yml) are the names that already have
  a certificate: until domain has one, the app keeps serving on the redirect
  domain that does, so changing DOMAIN never takes HTTPS down.
#}
{% set app_cert = domain if domain in tls_domains else (redirect_domains | select('in', tls_domains) | first) %}
{% set app_names = [domain] + ([app_cert] if app_cert != domain else []) %}
server {
    listen 80;
    # Every name, so certbot's nginx plugin finds each one for its challenge.
    server_name{% for name in ([domain] + redirect_domains) | unique %} {{ name }} www.{{ name }}{% endfor %};
    real_ip_header X-Forwarded-For;

    # The NodeBalancer's port-80 health check (infra/main.tf, check_body
    # "healthcheck") must get a 200; a redirect marks the backend down.
    location /healthcheck/ {
        return 200 "healthcheck";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% for old in redirect_domains if old in tls_domains and old not in [domain, app_cert] %}
# Old name: everything moves to {{ domain }}.
server {
    listen 443 ssl proxy_protocol;
    server_name {{ old }} www.{{ old }};
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ old }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ old }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    include /etc/nginx/snippets/myguy-security-headers.conf;

    location / {
        return 301 https://{{ domain }}$request_uri;
    }
}

{% endfor %}
server {
    # The NodeBalancer prepends a PROXY protocol header (infra/main.tf).
    listen 443 ssl proxy_protocol;
    server_name{% for name in app_names %} {{ name }} www.{{ name }}{% endfor %};
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ app_cert }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_cert }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    error_log /var/log/nginx/error.log warn;

    include /etc/nginx/snippets/myguy-security-headers.conf;

    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsecurity/coraza.conf;

    root {{ app_dir }}/frontend/dist;
    index index.html;

    # Never serve or route dot-files (/.git/config, /.env): scanners ask for
    # them first.  /.well-known/ stays reachable for certificates.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    location /healthcheck/ {
        return 200 "healthcheck";
        add_header Content-Type text/plain;
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    location /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1 {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Only the store service's own paths (API and uploaded images).  Other
    # /store/... URLs, such as the /store/:id item page, belong to the SPA.
    location ~ ^/store/(api|uploads)/ {
        rewrite ^/store/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /chat/ {
        rewrite ^/chat/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /socket.io {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Umami analytics on the monitoring instance.  Only the tracker and
    # heatmap recorder scripts, their event endpoints and the recorder's
    # settings are public; the Umami dashboard stays VPC-only.
    location = /umami/script.js {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/script.js;
    }

    location = /umami/api/send {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/api/send;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /umami/recorder.js {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/recorder.js;
    }

    location = /umami/api/record {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/api/record;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Only GET of one website's recorder settings, never the rest of
    # /api/websites/ (the dashboard API).
    # Quoted: an unquoted "{" in a regex would start an nginx block.
    location ~ "^/umami/api/websites/([0-9a-f-]{36})/recorder$" {
        limit_except GET { deny all; }
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/api/websites/$1/recorder;
    }

    # Build files are named by content hash, so they never change: cache them
    # for good, and 404 a missing one (an old build's) instead of answering
    # with index.html, which a browser can't run as a script.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    # The page itself points at the current build's files: always revalidate
    # it, so tabs pick up a deploy on their next load.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    location / {
        try_files $uri $uri/ @spa;
    }

    # App routes get the app.  Anything else answers 404 with the same page,
    # which shows the app's "Page not found" view to people.
    location @spa {
        error_page 404 /index.html;
        if ($spa_route = 0) {
            return 404;
        }
        rewrite ^ /index.html last;
    }
}
