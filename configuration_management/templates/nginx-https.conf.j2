server {
    listen 80;
    server_name {{ domain }} www.{{ domain }};
    real_ip_header X-Forwarded-For;

    # The NodeBalancer's port-80 health check (infra/main.tf, check_body
    # "healthcheck") must get a 200; a redirect marks the backend down.
    location /healthcheck/ {
        return 200 "healthcheck";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # The NodeBalancer prepends a PROXY protocol header (infra/main.tf).
    listen 443 ssl proxy_protocol;
    server_name {{ domain }} www.{{ domain }};
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    error_log /var/log/nginx/error.log warn;

    include /etc/nginx/snippets/myguy-security-headers.conf;

    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsecurity/coraza.conf;

    root {{ app_dir }}/frontend/dist;
    index index.html;

    location /healthcheck/ {
        return 200 "healthcheck";
        add_header Content-Type text/plain;
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    location /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1 {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Only the store service's own paths (API and uploaded images).  Other
    # /store/... URLs, such as the /store/:id item page, belong to the SPA.
    location ~ ^/store/(api|uploads)/ {
        rewrite ^/store/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /chat/ {
        rewrite ^/chat/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /socket.io {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Umami analytics on the monitoring instance.  Only the tracker script and
    # its event endpoint are public; the Umami dashboard stays VPC-only.
    location = /umami/script.js {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/script.js;
    }

    location = /umami/api/send {
        proxy_pass http://{{ monitoring_vpc_ip }}:3001/api/send;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Build files are named by content hash, so they never change: cache them
    # for good, and 404 a missing one (an old build's) instead of answering
    # with index.html, which a browser can't run as a script.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    # The page itself points at the current build's files: always revalidate
    # it, so tabs pick up a deploy on their next load.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/myguy-security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
