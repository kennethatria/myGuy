# http-level settings shared by the myguy site (included via conf.d).

# Traffic arrives through the Akamai NodeBalancer, which connects from this
# range.  Each server block picks the header carrying the real client IP:
# X-Forwarded-For on :80 (HTTP mode), PROXY protocol on :443 (TCP mode).
set_real_ip_from 192.168.255.0/24;

# Don't advertise the nginx version in the Server header or on error pages.
server_tokens off;

# JSON access log shipped to Loki by Promtail for the Visitors dashboard.
# Log the path as requested, minus the query string (which may carry tokens
# or search terms).  $uri is not usable: try_files rewrites every SPA route
# to /index.html before logging.
map $request_uri $request_path {
    "~^(?<path>[^?]*)" $path;
}

{% if geoip_country | default(false) %}
# Each visitor's country (ISO code) from DB-IP's free database
# (tasks/geoip.yml, refreshed monthly; reread without a reload).  Looked up
# from $remote_addr, which set_real_ip_from has already made the visitor's.
# "--" for addresses it doesn't know, such as private ones.
geoip2 /var/lib/geoip/country.mmdb {
    auto_reload 24h;
    $geoip_country default=-- country iso_code;
}

{% endif %}
# "country" goes last: fail2ban's nginx-auth-abuse filter (security.yml)
# matches the fields before it from the start of the line.
log_format visitor_json escape=json
    '{"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_path",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"referer":"$http_referer",'
    '"user_agent":"$http_user_agent"{% if geoip_country | default(false) %},"country":"$geoip_country"{% endif %}}';

access_log /var/log/nginx/access.json.log visitor_json;

# The single-page app's routes (frontend/src/router/index.ts; the test
# src/router/__tests__/nginxRoutes.spec.ts fails when they drift apart).
# Other paths get a 404: still the app's "Page not found" page, but the
# status lets fail2ban ban scanners probing for /.env, /wp-admin and the like.
map $uri $spa_route {
    default 0;
    "~^/(dashboard|login|register|messages|profile(/[^/]+)?|reviews(/[0-9]+|/create/[^/]+)?|my-gigs/(created|assigned|applications)|store(/[^/]+|/requests/[^/]+)?|tasks(/[^/]+)?|(edit|posted)/(task|item|request)/[0-9]+)?/?$" 1;
}

# Sign-in (/api/v1/auth/): 10 requests a minute per client IP, bursts of 5.
# A real sign-in takes 2-3 requests; this stops one client spraying code
# emails (email bombing) or guessing codes.  $binary_remote_addr is the real
# client (PROXY protocol / X-Forwarded-For, set_real_ip_from above).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
