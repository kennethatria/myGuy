server {
    listen 80;
    server_name{% for name in ([domain] + redirect_domains) | unique %} {{ name }} www.{{ name }}{% endfor %};
    real_ip_header X-Forwarded-For;

    root {{ app_dir }}/frontend/dist;
    index index.html;

    location /healthcheck/ {
        return 200 "healthcheck";
        add_header Content-Type text/plain;
    }

    location /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1 {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Only the store service's own paths (API and uploaded images).  Other
    # /store/... URLs, such as the /store/:id item page, belong to the SPA.
    location ~ ^/store/(api|uploads)/ {
        rewrite ^/store/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /chat/ {
        rewrite ^/chat/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /socket.io {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Build files are named by content hash, so they never change: cache them
    # for good, and 404 a missing one (an old build's) instead of answering
    # with index.html, which a browser can't run as a script.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The page itself points at the current build's files: always revalidate
    # it, so tabs pick up a deploy on their next load.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
